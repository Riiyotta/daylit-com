      "lineHeight": "23.94px"
    },
    "typography.label": {
      "fontFamily": "Tt Commons Pro Variable",
      "fontSize": "16px",
      "fontWeight": "500",
      "lineHeight": "23.94px"
    },
    "radius.control": "6px",
    "radius.surface": "1.85px",
    "radius.pill": "1440px",
    "elevation.default": "rgba(0, 0, 0, 0.1) 0px 4px 20px 0px",
    "motion.duration.default": "0.2s",
    "motion.easing.default": "ease"
  }
